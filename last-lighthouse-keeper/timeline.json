   "t0": 0.45,
   "t1": 3.94,
   "text": "Tonight, the lighthouse stops needing its keeper.",
   "at": 0.6,
   "end": 3.798
  },
  {
   "id": "L2",
   "t0": 3.95,
   "t1": 8.616,
   "text": "For 41 years, Elias climbed these steps at dusk.",
   "at": 4.1,
   "end": 8.016
  },
  {
   "id": "L3",
   "t0": 9.05,
   "t1": 11.74,
   "text": "Tomorrow, a machine takes over.",
   "at": 9.2,
   "end": 11.666
  },
  {
   "id": "L4",
   "t0": 11.75,
   "t1": 15.773,
   "text": "So tonight, he lights the lamp one last time.",
